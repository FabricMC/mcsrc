{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mcsrc",
  "compatibility_date": "2026-02-06",
  "routes": [
    {
      "pattern": "mcsrc.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "beta": {
      "name": "mcsrc-beta",
      "routes": [
        {
          "pattern": "beta.mcsrc.dev",
          "custom_domain": true
        }
      ]
    }
  }
}
